# Pinned identity of the in-browser toolchain we benchmark against.
# Everything here is derived by interrogating the exact binary the engine fetches
# (src/worker/mod.rs) and YoWASP's packaging repo. Re-derive with verify-toolchain.sh.

# The in-browser compiler binary the engine downloads and runs under wasmer.
WASM_BINARY_URL="https://fabioibanez.github.io/website/llvm.core.wasm"
WASM_BINARY_SHA256="24fbed474c7b5b4968fd73fc4827440b93fb351c1b6264516130300eff3e7bf5"
WASM_BINARY_BYTES="75532134"

# Sysroot (headers + libs) the engine unions into the VFS for compilation.
SYSROOT_URL="https://fabioibanez.github.io/website/llvm-resources.tar.gz"

# Source the binary was built from. The commit is baked into the binary's version
# string AND matches the llvm-src submodule pin in YoWASP/clang@develop.
LLVM_FORK_URL="https://codeberg.org/YoWASP/llvm-project"
LLVM_COMMIT="9560ae0f2cc440e4fc891fddbc119da6f56daa59"
LLVM_VERSION="22.1.0"

# YoWASP packaging repo (build.sh is the recipe; vendored in reference/).
YOWASP_CLANG_REPO="https://codeberg.org/YoWASP/clang"
YOWASP_CLANG_BRANCH="develop"

# Compilation target the engine uses (src/worker/mod.rs). The native compiler is
# built to compile *to this same target*, so compile-time is apples-to-apples;
# the only difference is the compiler itself runs native vs wasm-in-browser.
TARGET_TRIPLE="wasm32-wasip1"

# Pinned identity of the toolchain the native baseline is built from. Matches the
# engine's in-browser compiler family (src/worker/mod.rs) so codegen is consistent.

# Source the engine's binary was built from. The commit is baked into the binary's
# version string AND matches the llvm-src submodule pin in YoWASP/clang@develop.
LLVM_FORK_URL="https://codeberg.org/YoWASP/llvm-project"
LLVM_COMMIT="9560ae0f2cc440e4fc891fddbc119da6f56daa59"
LLVM_VERSION="22.1.0"

# YoWASP packaging repo (build.sh is the recipe; vendored in reference/).
YOWASP_CLANG_REPO="https://codeberg.org/YoWASP/clang"
YOWASP_CLANG_BRANCH="develop"

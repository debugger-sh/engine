// Golden test for StdStringFormatter. Covers the four libc++ std::string
// shapes that matter: empty (short, len 0), SSO (short, len <= 22), heap
// (long, follows pointer), and content with characters that need C-escapes.
// Each std::string is presented as a leaf with `value` = quoted, C-escaped
// contents — matching LLDB's summary format and dropping its raw __r_/__rep
// child for ergonomics.
{
  "steps": [
    {
      "type": "request",
      "command": "setBreakpoints",
      "arguments": {
        "source": { "path": "main.cpp" },
        "breakpoints": [{ "line": 8 }]
      }
    },
    {
      "type": "response",
      "body": {
        "breakpoints": {
          "$array.contains": [{ "line": 8, "verified": true }]
        }
      }
    },
    {
      "type": "request",
      "command": "configurationDone",
      "arguments": {}
    },
    {
      "type": "event",
      "event": "stopped",
      "body": {
        "reason": "breakpoint",
        "threadId": "${{thread}}"
      }
    },
    {
      "type": "request",
      "command": "stackTrace",
      "arguments": { "threadId": "{{thread}}" }
    },
    {
      "type": "response",
      "body": {
        "stackFrames": {
          "$array.contains": [{ "name": "main", "id": "${{mainFrame}}" }]
        }
      }
    },
    {
      "type": "request",
      "command": "scopes",
      "arguments": { "frameId": "{{mainFrame}}" }
    },
    {
      "type": "response",
      "body": {
        "scopes": {
          "$array.contains": [
            { "name": "Locals", "variablesReference": "${{locals}}" }
          ]
        }
      }
    },
    {
      "type": "request",
      "command": "variables",
      "arguments": { "variablesReference": "{{locals}}" }
    },
    {
      "type": "response",
      "body": {
        "variables": {
          "$array.contains": [
            { "name": "empty",       "value": "\"\"",                  "variablesReference": 0 },
            { "name": "sso",         "value": "\"hello\"",             "variablesReference": 0 },
            { "name": "heap",        "value": "\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"", "variablesReference": 0 },
            { "name": "with_quotes", "value": "\"he said \\\"hi\\\"\\n\"", "variablesReference": 0 }
          ]
        }
      }
    },
    {
      "type": "request",
      "command": "continue",
      "arguments": { "threadId": "{{thread}}" }
    }
  ]
}
